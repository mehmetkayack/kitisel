# =============================================================================
# Kitisel production ortam değişkenleri (docker-compose.prod.yml)
#   cp .env.production.example .env.production   → değerleri doldurun
# Bu dosya hem Compose'a (--env-file) hem konteynerlere (env_file) verilir. Gerçek değerleri asla repoya
# eklemeyin (.gitignore'da). Tüm değişkenlerin açıklaması: .env.example ve packages/config/src/env.ts
# =============================================================================

# --- Alan adı ve HTTPS (Caddy) ----------------------------------------------------
# Sadece alan adı (https:// ve / olmadan). DNS'te bu ad ve www.<ad> sunucunun IP'sini göstermeli.
DOMAIN=kitisel.com
# Let's Encrypt sertifika bildirimleri için
ACME_EMAIL=

# --- İmaj ----------------------------------------------------------------------------------------
# GitHub Actions'ın derlediği imaj (küçük sunucuda önerilen). Boşsa sunucuda derlenir (en az 4 GB RAM).
APP_IMAGE=ghcr.io/mehmetkayack/kitisel:latest

# --- Bellek (1 GB RAM + 2 GB swap için; 2 GB+ sunucuda büyütebilirsiniz) ---------------------------
API_HEAP_MB=192
WORKER_HEAP_MB=320
WEB_HEAP_MB=160
MYSQL_BUFFER_POOL=128M
REDIS_MAXMEMORY=96mb

# --- Uygulama adresleri -------------------------------------------------------------
# İkisi de herkese açık adres (https). API aynı alan adında /api altında.
WEB_URL=https://kitisel.com
API_URL=https://kitisel.com
LOG_LEVEL=info

# --- MySQL (konteyner) ---------------------------------------------------------------
# Uygulama kullanıcısı (root OLAMAZ). Uzun, rastgele şifreler kullanın:
#   openssl rand -base64 32
MYSQL_DATABASE=kitisel
MYSQL_USER=kitisel
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Küçük sunucuda düşük tutun
MYSQL_POOL_MAX=5

# --- Kuyruk ---------------------------------------------------------------------------
QUEUE_PREFIX=kitisel

# --- Kimlik doğrulama -------------------------------------------------------------------
# En az 32 karakter:  openssl rand -base64 48
JWT_ACCESS_SECRET=
COOKIE_SECURE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Cloud Console'da bu iki adresi "Authorized redirect URIs" listesine ekleyin
GOOGLE_REDIRECT_URI=https://kitisel.com/api/v1/auth/google/callback
GOOGLE_GSC_REDIRECT_URI=https://kitisel.com/api/v1/connections/search-console/callback

# --- Şifreleme (CMS ve Search Console kimlik bilgileri) -------------------------------------
# ZORUNLU ve bir kez belirlenir; değişirse kayıtlı bağlantılar açılamaz. Yedekleyin.
#   openssl rand -base64 32
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# --- Yapay zekâ (Gemini) ----------------------------------------------------------------------
# Not: ücretsiz katmanda gönderilen veriler Google tarafından kullanılabilir; müşteriye satıştan önce ücretli katman.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_QUALITY=gemini-3.6-flash-lite
GEMINI_MODEL_REASONING=
GEMINI_MODEL_IMAGE=gemini-3.1-flash-image
GEMINI_MODEL_EMBEDDING=gemini-embedding-001
# Küçük sunucuda aynı anda tek yapay zekâ çağrısı
AI_MAX_CONCURRENCY=1
AI_RPM_LIMIT=10
AI_DAILY_REQUEST_BUDGET=500
AI_PRICING_JSON=
AI_REQUEST_TIMEOUT_MS=120000

# --- Site tarayıcı ------------------------------------------------------------------------------
CRAWLER_MAX_PAGES=25
CRAWLER_USER_AGENT=KitiselBot/1.0 (+https://kitisel.com)

# --- İçerik üretimi -------------------------------------------------------------------------------
GENERATE_AHEAD_HOURS=72

# --- Anahtar kelime verisi (isteğe bağlı) --------------------------------------------------------
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Ödeme: PayTR (kart) + havale/EFT -------------------------------------------------------------
# Mağaza Paneli → Destek & Kurulum → Entegrasyon Bilgileri. Canlı satışta PAYTR_TEST_MODE=false.
# Bildirim URL'i (Mağaza Paneli → Destek & Kurulum → Ayarlar): https://<alan adı>/api/v1/billing/paytr/callback
BILLING_PROVIDER=paytr
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=true

# KDV oranı (%): sadece fatura ülkesi Türkiye olan siparişlere eklenir; yurt dışı müşteride 0 (hizmet ihracatı).
BILLING_VAT_RATE=20
# Havale/EFT: en az bir IBAN doluysa ödeme sayfasında seçenek olarak çıkar; sipariş admin panelinden onaylanınca paket açılır.
# TL hesabına ödemede tutar TCMB döviz satış kuruyla TL'ye çevrilip gösterilir.
BANK_ACCOUNT_HOLDER=
BANK_NAME=
BANK_IBAN_USD=
BANK_IBAN_TRY=

# --- E-posta ---------------------------------------------------------------------------------------------
# DigitalOcean gibi giden SMTP portlarını (25/465/587) engelleyen sunucularda SMTP çalışmaz (ETIMEDOUT):
# EMAIL_PROVIDER=resend (RESEND_API_KEY) ya da brevo (BREVO_API_KEY) kullanın; HTTPS (443) ile gönderir.
# Gönderici alan adını (EMAIL_FROM) seçtiğiniz servisin panelinde DNS kayıtlarıyla doğrulayın.
EMAIL_PROVIDER=smtp
EMAIL_FROM=Kitisel <no-reply@kitisel.com>
RESEND_API_KEY=
BREVO_API_KEY=
# --- SMTP (EMAIL_PROVIDER=smtp ise) -----------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# --- Bot koruması ---------------------------------------------------------------------------------------
# Site anahtarları çalışma anında okunur: değiştirince `up -d` yeterli (yeniden derleme yok). Cloudflare'in
# 1x00000000.../3x00000000... test anahtarlarını canlıda kullanmayın.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# reCAPTCHA v3: Google yönetim sayfasında alan adlarına DOMAIN'i ekleyin. Production'da gizli anahtar
# yoksa iletişim formu gönderimi reddedilir.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# --- İletişim formu bildirimi ------------------------------------------------------------------------------
# Boşsa LEGAL_EMAIL'e gider
CONTACT_NOTIFY_EMAIL=
CONTACT_NOTIFY_LOCALE=tr

# --- Google Analytics 4 (sadece halka açık site; ziyaretçi onay verirse yüklenir) ---------------------------
# Yeniden derleme gerekmez: değiştirip `up -d --no-build --force-recreate web` yeter.
GA_MEASUREMENT_ID=

# --- Satıcı bilgileri (iletişim, alt bilgi, yasal sayfalar) -------------------------------------------------
# Ödeme kuruluşu başvurusunda vergi levhasıyla aynı olmalı.
LEGAL_COMPANY_NAME=
LEGAL_ADDRESS=
LEGAL_TAX_OFFICE=
LEGAL_TAX_NUMBER=
LEGAL_MERSIS=
LEGAL_PHONE=
LEGAL_EMAIL=
LEGAL_KEP=
LEGAL_JURISDICTION=
LEGAL_HOSTING=

# --- Hata takibi (isteğe bağlı) -------------------------------------------------------------------------------
SENTRY_DSN=
