# =============================================================================
# Upvine ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayın. Gerçek değerleri asla repoya eklemeyin.
# Doğrulama şeması: packages/config/src/env.ts (bu dosya ile senkron tutulur)
# =============================================================================

# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Uygulama URL'leri ------------------------------------------------------
# Tarayıcının açtığı adres. Geliştirmede Vite, /api isteklerini API'ye proxy'ler.
WEB_URL=http://localhost:5173
# API'nin kendi adresi (Vite proxy hedefi, e-posta linkleri değil)
API_URL=http://localhost:4000
API_PORT=4000

# --- MySQL 8 (utf8mb4) --------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=upvine
MYSQL_PASSWORD=
MYSQL_DATABASE=upvine
# Testler bu veritabanını her çalıştırmada sıfırlar. Asıl veritabanıyla AYNI OLMAMALI.
MYSQL_TEST_DATABASE=upvine_test
MYSQL_POOL_MIN=0
MYSQL_POOL_MAX=10
# true ise SQL sorguları loglanır (sadece geliştirme)
MYSQL_LOG_SQL=false

# --- Redis (BullMQ, rate limit, önbellek). Redis 6.2+ veya Memurai ---------------
REDIS_URL=redis://127.0.0.1:6379
# BullMQ kuyruk öneki (aynı Redis'i paylaşan ortamlar için farklı olmalı; e2e testleri kendi önekini kullanır)
QUEUE_PREFIX=upvine

# --- Kimlik doğrulama ---------------------------------------------------------
# En az 32 karakter rastgele değer. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Access token ömrü (saniye). Spec: 15 dakika
JWT_ACCESS_TTL_SECONDS=900
# Refresh token ömrü (gün)
REFRESH_TOKEN_TTL_DAYS=30
# Çerezlerde Secure bayrağı. localhost'ta tarayıcılar Secure çerezi kabul eder; false yapmayın.
COOKIE_SECURE=true

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Yetkili yönlendirme URI'si olarak GOOGLE_REDIRECT_URI değerini ekleyin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback
# Search Console bağlantısı: aynı istemciye ikinci yetkili yönlendirme URI'si olarak ekleyin. Google Cloud'da
# "Google Search Console API"yi etkinleştirin ve OAuth izin ekranına webmasters.readonly kapsamını ekleyin.
# İzin ekranı "Testing" durumundaysa kendinizi test kullanıcısı yapın (refresh token 7 gün geçerli olur).
GOOGLE_GSC_REDIRECT_URI=http://localhost:5173/api/v1/connections/search-console/callback

# --- Yapay zekâ: Google Gemini (Faz 1) ----------------------------------------
# Model adları koda gömülmez. Güncel liste: https://ai.google.dev/gemini-api/docs/models
# Önerilen değerler 2026-10-09'da bu listeden kontrol edildi (kararlı modeller).
# Anahtar yoksa uygulama çökmez: analiz yapay zekâsız (sezgisel) çalışır, konu önerisi kapalıdır.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Flash-Lite sınıfı: sınıflandırma, meta, alt metin
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# Flash sınıfı: outline, makale, yenileme
GEMINI_MODEL_QUALITY=gemini-3.6-flash-lite
# Pro sınıfı (genellikle ücretli katman), isteğe bağlı
GEMINI_MODEL_REASONING=
# Görsel üretim modeli
GEMINI_MODEL_IMAGE=gemini-3.1-flash-image
# Embedding modeli
GEMINI_MODEL_EMBEDDING=gemini-embedding-001
AI_MAX_CONCURRENCY=2
# Dakika başı istek limiti ve günlük istek bütçesi (AI Studio'daki limitlerinize göre)
AI_RPM_LIMIT=10
AI_DAILY_REQUEST_BUDGET=500
# İsteğe bağlı model fiyatları (USD / 1M token), maliyet takibi için. Boşsa maliyet 0 yazılır (ücretsiz katman).
# Örnek: {"gemini-3.8-flash":{"input":0.3,"output":2.5}}
AI_PRICING_JSON=
# Tek çağrı için en fazla bekleme (ms). Yoğunlukta yanıt gelmezse çağrı yeniden denenir / hızlı modele düşülür.
AI_REQUEST_TIMEOUT_MS=120000

# --- Site tarayıcı (Faz 1) ------------------------------------------------------
# Analizde taranacak en fazla sayfa ve kendi User-Agent'ımız (robots.txt'ye uyulur)
CRAWLER_MAX_PAGES=25
CRAWLER_USER_AGENT=UpvineBot/1.0 (+https://upvine.app/bot)
# Sadece uçtan uca testler (Playwright otomatik açar): sahte site + sahte yapay zekâ. Production'da yok sayılır.
E2E_FAKE_EXTERNALS=false

# --- İçerik üretimi ---------------------------------------------------------------
# Aylık makale hakkını ezer (sadece geliştirme). Boşsa paket hakkı, paket yoksa deneme hakkı (3) geçerli.
ARTICLE_QUOTA_OVERRIDE=
# Yayın tarihine kaç saat kala makale yazılsın
GENERATE_AHEAD_HOURS=72

# --- Anahtar kelime verisi: DataForSEO (Faz 2) ---------------------------------
# Boş bırakılırsa Gemini tahmini kullanılır ve "tahmini" olarak işaretlenir.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Ödeme: iyzico abonelik API'si (Faz 3) -------------------------------------
BILLING_PROVIDER=iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Sandbox: https://sandbox-api.iyzipay.com  Production: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# --- E-posta ------------------------------------------------------------------
# smtp | resend. Geliştirmede Mailpit (SMTP 1025, arayüz http://localhost:8025)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Upvine <no-reply@upvine.local>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# --- Dosya depolama: Cloudflare R2 (S3 uyumlu) ---------------------------------
# Sadece geçici dosyalar (görseller 30 gün sonra silinir)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Hata takibi --------------------------------------------------------------
SENTRY_DSN=

# --- Şifreleme (CMS ve Search Console kimlik bilgileri, AES-256-GCM) -----------
# base64 kodlu 32 bayt. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Anahtar rotasyonunda artırılır
ENCRYPTION_KEY_VERSION=1

# --- Cloudflare Turnstile (ücretsiz analiz, Faz 1) ------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Yasal sayfalar: satıcı bilgileri (/legal/*, İletişim, alt bilgi) ----------
# Gizli değildir; sayfalarda görünür. Boş alanlar sayfada [köşeli parantez] ile gösterilir.
# Ödeme kuruluşu (iyzico) başvurusunda bu bilgiler vergi levhasıyla aynı olmalı.
# Ticari unvan (şahıs şirketinde ad soyad)
LEGAL_COMPANY_NAME=
LEGAL_ADDRESS=
LEGAL_TAX_OFFICE=
LEGAL_TAX_NUMBER=
# İsteğe bağlı: MERSİS numarası ve KEP adresi
LEGAL_MERSIS=
LEGAL_PHONE=
LEGAL_EMAIL=
LEGAL_KEP=
# Ticari uyuşmazlıklarda yetkili mahkeme şehri (ör. İstanbul (Anadolu))
LEGAL_JURISDICTION=
# Barındırma sağlayıcısı ve veri merkezi ülkesi (ör. Hetzner Online GmbH, Almanya)
LEGAL_HOSTING=
