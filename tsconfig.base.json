{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    // Workspace paketleri symlink yerine alias ile çözülür (D: exFAT, bkz. CLAUDE.md > Kararlar).
    // Bu harita tek doğruluk kaynağıdır: tsx, esbuild ve TypeScript doğrudan okur,
    // Vite/Vitest için scripts/workspace-aliases.ts aynı haritadan alias üretir.
    "paths": {
      "@upvine/config": ["./packages/config/src/index.ts"],
      "@upvine/config/env": ["./packages/config/src/env.ts"],
      "@upvine/db": ["./packages/db/src/index.ts"],
      "@upvine/db/testing": ["./packages/db/src/testing.ts"],
      "@upvine/shared": ["./packages/shared/src/index.ts"],
      "@upvine/email": ["./packages/email/src/index.tsx"],
      "@upvine/locales": ["./locales/index.ts"],
      "@upvine/ui": ["./packages/ui/src/index.ts"],
      "@upvine/ui/*": ["./packages/ui/src/*"],
      "@upvine/ai": ["./packages/ai/src/index.ts"],
      "@upvine/seo": ["./packages/seo/src/index.ts"],
      "@upvine/seo/testing": ["./packages/seo/src/testing.ts"],
      "@upvine/publishers": ["./packages/publishers/src/index.ts"],
      "@upvine/keywords": ["./packages/keywords/src/index.ts"],
      "@upvine/billing": ["./packages/billing/src/index.ts"]
    }
  }
}
